module attributes {pto.backend = "vpto", pto.target_arch = "a5"} {
  module attributes {pto.backend = "vpto", pto.kernel_kind = #pto.kernel_kind<vector>, pto.target_arch = "a5"} {
    func.func @ComputeOcp_bf16(
        %rowNum: i16,
        %colBlockSize: i32,
        %xAddr: !pto.ptr<ui16, ub>,
        %mxScale1Addr: !pto.ptr<ui8, ub>,
        %mxScale2Addr: !pto.ptr<ui8, ub>,
        %mxScaleReciprocalAddr: !pto.ptr<ui16, ub>,
        %gatherIndexAddr: !pto.ptr<ui8, ub>,
        %yMaxExp: i16,
        %ubBlockSize: i16,
        %vlForHalfNumber: i16) attributes {pto.kernel} {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %c2 = arith.constant 2 : index
      %c0_i16 = arith.constant 0 : i16
      %c64_i16 = arith.constant 64 : i16
      %c255_i16 = arith.constant 255 : i16
      %c32512_i16 = arith.constant 32512 : i16
      %c32640_i16 = arith.constant 32640 : i16
      %c32641_i16 = arith.constant 32641 : i16
      %c7_i16 = arith.constant 7 : i16

      %row_count = arith.index_cast %rowNum : i16 to index
      %ub_block = arith.index_cast %ubBlockSize : i16 to index
      %vl_half = arith.index_cast %vlForHalfNumber : i16 to index
      %load_stride = arith.muli %vl_half, %c2 : index
      %xBf = pto.castptr %xAddr : !pto.ptr<ui16, ub> -> !pto.ptr<bf16, ub>

      // ========================================================================
      // MI - Block MX Quant Scale OCP bf16 (硬件细节完整暴露)
      //
      // 算法流程: 逐行加载 bf16 -> 提取指数 -> 逐元素/跨行求 amax -> 计算 scale(s)
      //   -> 边界值处理 -> 写入 scale1/scale2/reciprocal
      //
      // 开发者需要理解和处理以下硬件细节:
      //
      //   1. DINTLV_B16 交错加载: 一行 bf16 被拆成 x0(偶数索引) + x1(奇数索引) 两路 128
      //   2. 双累加器归约: 因 DINTLV 拆分, expMax1Dim2 和 expMax2Dim2 分别归约, 最后 vmax 合并
      //   3. mask 粒度管理: b16(vand/vmax/vcmp/vsel/vsub) + b8(vsts) + b16(vsts) 三种
      //   4. vcgmax 隐式广播: 单条指令完成跨 lane 归约+广播, 结果在 128 宽寄存器中自动复制
      //   5. vpack LOWER: 将 bf16 低字节提取为 scale1, 需指定 LOWER 半区
      //   6. vselr gather: 硬件 gather 指令从 mxScale1 中按 gatherIndex 选取 scale2
      //   7. vsts dist 模式: NORM_B8/NORM_B16 指定不同位宽的写入方式
      //
      // 对比 VMI: 256-wide 逻辑向量 + 无 mask 参数 + 单累加器 + 显式 reduce/broadcast。
      // ========================================================================

      pto.vecscope {
        // Expected UB effect of this vecscope:
        // - Input already in UB: xAddr contains bf16 block rows. The vector code
        //   reads exponent bits only; it does not modify xAddr.
        // - Outputs modified in UB:
        //   * mxScale1Addr receives compact E8M0 scale bytes for each row/block group.
        //   * mxScale2Addr receives the scale bytes in the row-interleaved layout
        //     selected by gatherIndexAddr.
        //   * mxScaleReciprocalAddr receives bf16 exponent-field reciprocal scales
        //     used by the later quantization stage.
        // - Mathematical purpose: compute the OCP MX shared scale from the maximum
        //   bf16 exponent over the 32-row/32-column block, clamp against yMaxExp,
        //   encode scale1 as E8M0, and compute reciprocal exponent bias - max_exp.
        // - Special cases: Inf/NaN blocks produce E8M0 0xFF and bf16 NaN reciprocal;
        //   all-zero blocks produce zero scale and zero reciprocal; invalid/subnormal
        //   reciprocal cases are replaced with specialExp.
        // Instruction reading guide for this MI file:
        // - pto.mi.vldsx2 "DINTLV_B16" is the first physical split: a 256-element
        //   bf16 row cannot fit in one 256-byte register, so even logical indices
        //   go to x0Bf16 and odd logical indices go to x1Bf16.
        // - pto.mi.vbitcast reinterprets bf16 bits as i16 without changing lanes;
        //   pto.mi.vand with 0x7F80 extracts the bf16 exponent field.
        // - pto.mi.vmax and pto.mi.vcgmax implement running max and cross-lane max, but
        //   each operation still names a concrete b16 predicate.
        // - pto.mi.vpack "LOWER", pto.mi.vselr, and pto.mi.vsts NORM_B8/NORM_B16 are
        //   storage/layout instructions for scale bytes and reciprocal halfwords.
        // VMI equivalents collapse the even/odd ownership into one logical
        // vreg<256x...>, use group_reduce_maxi/group_broadcast for the reduction,
        // and use trunci/store for typed narrowing and UB writes.
        // MI: 需要四种 mask - pset_b16(全量b16), pset_b8(全量b8), pge_b8(VL8), pge_b16(VL16)。
        // 不同操作需要不同粒度的 mask: vand/vcmp/vsel/vsub 用 b16, vsts NORM_B8 用 b8, 等等。
        // 对比 VMI: vmi.create_mask 统一为 vmi.mask<256xpred>。

        // All 128 b16 lanes active: used by exponent bit ops, comparisons,
        // selects, subtracts, shifts, and the cross-lane max.
        %pregAllB16 = pto.mi.pset_b16 "PAT_ALL" : !pto.mi.mask<b16>
        // All 256 b8 lanes active: used when writing the full scale2 byte vector.
        %pregAllB8 = pto.mi.pset_b8 "PAT_ALL" : !pto.mi.mask<b8>
        // First 8 b8 lanes active: scale1 has only 8 meaningful bytes per row.
        %pregReduceB8 = pto.mi.pge_b8 "PAT_VL8" : !pto.mi.mask<b8>
        // First 16 b16 lanes active: reciprocal store writes the compact halfword set.
        %pregReduceB16 = pto.mi.pge_b16 "PAT_VL16" : !pto.mi.mask<b16>

        // 0x7F80 broadcast: bf16 exponent mask, preserving bits [14:7].
        %expMaskBF16 = pto.mi.vbr %c32640_i16 : i16 -> !pto.mi.vreg<128xi16>
        // MI: vbr 广播标量到 128-wide——因 DINTLV 拆分, 所有常量仅 128 宽。
        // 对比 VMI: vmi.broadcast 广播到 256-wide, 与数据宽度一致。

        // Running max accumulator for even-index DINTLV half, initialized to exponent 0.
        %expMax1Dim2Init = pto.mi.vbr %c0_i16 : i16 -> !pto.mi.vreg<128xi16>
        // Running max accumulator for odd-index DINTLV half, initialized to exponent 0.
        %expMax2Dim2Init = pto.mi.vbr %c0_i16 : i16 -> !pto.mi.vreg<128xi16>
        // Target output maximum exponent in bf16 exponent-field position.
        %yMaxExpReg = pto.mi.vbr %yMaxExp : i16 -> !pto.mi.vreg<128xi16>
        // E8M0 NaN byte value 0xFF, held in i16 lanes until vpack LOWER.
        %nanE8M0 = pto.mi.vbr %c255_i16 : i16 -> !pto.mi.vreg<128xi16>
        // bf16 bias 127 encoded as exponent field 0x7F00.
        %biasE8M0 = pto.mi.vbr %c32512_i16 : i16 -> !pto.mi.vreg<128xi16>
        // All-zero vector used for zero-block comparisons and selections.
        %zero = pto.mi.vbr %c0_i16 : i16 -> !pto.mi.vreg<128xi16>
        // Custom bf16 NaN pattern used for reciprocal output on Inf/NaN blocks.
        %nanBF16 = pto.mi.vbr %c32641_i16 : i16 -> !pto.mi.vreg<128xi16>
        // Special reciprocal threshold for invalid/subnormal reciprocal cases.
        %specialExp = pto.mi.vbr %c64_i16 : i16 -> !pto.mi.vreg<128xi16>

        %expMax1Dim2, %expMax2Dim2 = scf.for %i = %c0 to %row_count step %c1
            iter_args(%acc0 = %expMax1Dim2Init, %acc1 = %expMax2Dim2Init)
            -> (!pto.mi.vreg<128xi16>, !pto.mi.vreg<128xi16>) {
          %loadOffset = arith.muli %i, %load_stride : index
          // MI: vldsx2 + DINTLV_B16 交错加载一行 bf16 -> x0(偶数索引), x1(奇数索引) 两路 128。
          // 对比 VMI: vmi.load 加载 256-wide 逻辑连续向量。

          %x0Bf16, %x1Bf16 = pto.mi.vldsx2 %xBf[%loadOffset], "DINTLV_B16"
            : !pto.ptr<bf16, ub>, index -> !pto.mi.vreg<128xbf16>, !pto.mi.vreg<128xbf16>
          // MI: vbitcast bf16->i16 重解释, 然后 vand 提取指数位 (bf16 指数在位[14:7])。
          // vand 需绑定 mask<b16>, 即使是对所有元素操作。
          // 对比 VMI: vmi.bitcast + vmi.andi (无 mask)。

          // Reinterpret even-index bf16 values as i16 bit patterns; no numeric conversion.
          %x0Bits = pto.mi.vbitcast %x0Bf16 : !pto.mi.vreg<128xbf16> -> !pto.mi.vreg<128xi16>
          // Reinterpret odd-index bf16 values as i16 bit patterns.
          %x1Bits = pto.mi.vbitcast %x1Bf16 : !pto.mi.vreg<128xbf16> -> !pto.mi.vreg<128xi16>
          // Extract bf16 exponent field from even-index half: x0Bits & 0x7F80.
          %x0ExpBF16 = pto.mi.vand %x0Bits, %expMaskBF16, %pregAllB16
            : !pto.mi.vreg<128xi16>, !pto.mi.vreg<128xi16>, !pto.mi.mask<b16> -> !pto.mi.vreg<128xi16>
          // Extract bf16 exponent field from odd-index half: x1Bits & 0x7F80.
          %x1ExpBF16 = pto.mi.vand %x1Bits, %expMaskBF16, %pregAllB16
            : !pto.mi.vreg<128xi16>, !pto.mi.vreg<128xi16>, !pto.mi.mask<b16> -> !pto.mi.vreg<128xi16>
          // MI: vmax 逐元素取 max——需绑定 mask<b16>。x0/x1 两路分别归约。
          // 对比 VMI: cmpi + select 组合 (无 mask), 单路归约。

          // Update running max for even-index lanes across rows.
          %nextAcc0 = pto.mi.vmax %acc0, %x0ExpBF16, %pregAllB16
            : !pto.mi.vreg<128xi16>, !pto.mi.vreg<128xi16>, !pto.mi.mask<b16> -> !pto.mi.vreg<128xi16>
          // Update running max for odd-index lanes across rows.
          %nextAcc1 = pto.mi.vmax %acc1, %x1ExpBF16, %pregAllB16
            : !pto.mi.vreg<128xi16>, !pto.mi.vreg<128xi16>, !pto.mi.mask<b16> -> !pto.mi.vreg<128xi16>
          scf.yield %nextAcc0, %nextAcc1 : !pto.mi.vreg<128xi16>, !pto.mi.vreg<128xi16>
        }

        // ========================================================================
        // 阶段2: 跨行归约 - 合并两路 + 全局 vcgmax
        // MI: 先 vmax 合并两路 max, 再 vcgmax 跨 lane 归约+广播 (结果自动复制到 128 宽)。
        // 对比 VMI: group_reduce_maxi(num_groups=1) + group_broadcast 显式两步。
        // ========================================================================

        // Merge the even/odd DINTLV accumulators element-wise before global reduction.
        %expMaxDimPre = pto.mi.vmax %expMax1Dim2, %expMax2Dim2, %pregAllB16
          : !pto.mi.vreg<128xi16>, !pto.mi.vreg<128xi16>, !pto.mi.mask<b16> -> !pto.mi.vreg<128xi16>
        // Cross-lane max and broadcast: every lane receives the block max exponent.
        %expMaxDim0 = pto.mi.vcgmax %expMaxDimPre, %pregAllB16
          : !pto.mi.vreg<128xi16>, !pto.mi.mask<b16> -> !pto.mi.vreg<128xi16>

        // ========================================================================
        // 阶段3: scale 计算 - vcmp 比较 + vsel 选择 + vsub 减法 + vshrs 移位
        // MI: 每条 vcmp/vsel/vsub/vshrs 都需 mask<b16>, 代码中 mask 参数反复出现。
        // 对比 VMI: cmpi/select/subi/shrui 无 mask。
        // ========================================================================

        // Predicate is true for non-Inf/NaN blocks because vcmp mode is "ne".
        %infMask = pto.mi.vcmp %expMaxDim0, %expMaskBF16, %pregAllB16, "ne"
          : !pto.mi.vreg<128xi16>, !pto.mi.vreg<128xi16>, !pto.mi.mask<b16> -> !pto.mi.mask<b16>
        // Predicate is true for non-zero blocks because vcmp mode is "ne".
        %zeroMask = pto.mi.vcmp %expMaxDim0, %zero, %pregAllB16, "ne"
          : !pto.mi.vreg<128xi16>, !pto.mi.vreg<128xi16>, !pto.mi.mask<b16> -> !pto.mi.mask<b16>
        // Predicate marks expMax <= yMaxExp, i.e. values too small for normal scale.
        %invalidDataMask = pto.mi.vcmp %expMaxDim0, %yMaxExpReg, %pregAllB16, "le"
          : !pto.mi.vreg<128xi16>, !pto.mi.vreg<128xi16>, !pto.mi.mask<b16> -> !pto.mi.mask<b16>
        // Clamp low/invalid exponent blocks up to yMaxExp before subtracting.
        %expMaxDim1 = pto.mi.vsel %yMaxExpReg, %expMaxDim0, %invalidDataMask
          : !pto.mi.vreg<128xi16>, !pto.mi.vreg<128xi16>, !pto.mi.mask<b16> -> !pto.mi.vreg<128xi16>
        // Compute exponent delta in bf16 exponent-field units: expMax - yMaxExp.
        %expMaxDim2 = pto.mi.vsub %expMaxDim1, %yMaxExpReg, %pregAllB16
          : !pto.mi.vreg<128xi16>, !pto.mi.vreg<128xi16>, !pto.mi.mask<b16> -> !pto.mi.vreg<128xi16>
        // Shift right by 7 to convert bf16 exponent-field placement into E8M0 byte value.
        %mxScaleB16_0 = pto.mi.vshrs %expMaxDim2, %c7_i16, %pregAllB16
          : !pto.mi.vreg<128xi16>, i16, !pto.mi.mask<b16> -> !pto.mi.vreg<128xi16>
        // For Inf/NaN blocks, select 0xFF; otherwise keep computed scale.
        %mxScaleB16_1 = pto.mi.vsel %mxScaleB16_0, %nanE8M0, %infMask
          : !pto.mi.vreg<128xi16>, !pto.mi.vreg<128xi16>, !pto.mi.mask<b16> -> !pto.mi.vreg<128xi16>
        // For zero blocks, select 0; otherwise keep the previous scale result.
        %mxScaleB16_2 = pto.mi.vsel %mxScaleB16_1, %zero, %zeroMask
          : !pto.mi.vreg<128xi16>, !pto.mi.vreg<128xi16>, !pto.mi.mask<b16> -> !pto.mi.vreg<128xi16>
        // MI: vpack LOWER 将 bf16 的低字节提取为 scale1 字节。需指定 LOWER 半区。
        // 对比 VMI: vmi.trunci i32->ui8 语义截断。

        // Pack low bytes of i16 scale lanes into a uint8 vector for scale1/scale2 storage.
        %mxScale1B8 = pto.mi.vpack %mxScaleB16_2, "LOWER"
          : !pto.mi.vreg<128xi16> -> !pto.mi.vreg<256xui8>

        scf.for %i = %c0 to %row_count step %c1 {
          %scaleOff = arith.muli %i, %ub_block : index
          // Store the compact scale1 bytes for this row; only first 8 b8 lanes are meaningful.
          pto.mi.vsts %mxScale1B8, %mxScale1Addr[%scaleOff], %pregReduceB8 {dist = "NORM_B8"}
            : !pto.mi.vreg<256xui8>, !pto.ptr<ui8, ub>, !pto.mi.mask<b8>
        }

        // MI: vlds 加载 gatherIndex, 然后 vselr 按索引从 mxScale1 选取 scale2 字节。
        // 对比 VMI: 归约广播后所有 lane 值相同, 直接 store scale1Full 即可。

        // Load gather indices that describe the scale2 interleaved output layout.
        %gatherIndex = pto.mi.vlds %gatherIndexAddr[%c0] {dist = "NORM"}
          : !pto.ptr<ui8, ub> -> !pto.mi.vreg<256xui8>
        // Gather selected scale1 bytes into the scale2 row layout.
        %mxScale2B8 = pto.mi.vselr %mxScale1B8, %gatherIndex
          : !pto.mi.vreg<256xui8>, !pto.mi.vreg<256xui8> -> !pto.mi.vreg<256xui8>
        // Store full scale2 byte vector.
        pto.mi.vsts %mxScale2B8, %mxScale2Addr[%c0], %pregAllB8 {dist = "NORM_B8"}
          : !pto.mi.vreg<256xui8>, !pto.ptr<ui8, ub>, !pto.mi.mask<b8>

        // ========================================================================
        // 阶段4: reciprocal scale - vsub + vsel 链, 每条带 mask<b16> + vbitcast i16->ui16
        // 对比 VMI: subi + select 链无 mask, trunci 自动处理类型转换。
        // ========================================================================

        // Detect reciprocal edge case where exponent delta equals the bf16 bias field.
        %invalidRecipMask = pto.mi.vcmp %expMaxDim2, %biasE8M0, %pregAllB16, "eq"
          : !pto.mi.vreg<128xi16>, !pto.mi.vreg<128xi16>, !pto.mi.mask<b16> -> !pto.mi.mask<b16>
        // Reciprocal exponent field: bias - exponent_delta.
        %reversedShareExp0 = pto.mi.vsub %biasE8M0, %expMaxDim2, %pregAllB16
          : !pto.mi.vreg<128xi16>, !pto.mi.vreg<128xi16>, !pto.mi.mask<b16> -> !pto.mi.vreg<128xi16>
        // Inf/NaN blocks receive custom bf16 NaN reciprocal; others keep computed reciprocal.
        %reversedShareExp1 = pto.mi.vsel %reversedShareExp0, %nanBF16, %infMask
          : !pto.mi.vreg<128xi16>, !pto.mi.vreg<128xi16>, !pto.mi.mask<b16> -> !pto.mi.vreg<128xi16>
        // Zero blocks receive reciprocal 0.
        %reversedShareExp2 = pto.mi.vsel %reversedShareExp1, %zero, %zeroMask
          : !pto.mi.vreg<128xi16>, !pto.mi.vreg<128xi16>, !pto.mi.mask<b16> -> !pto.mi.vreg<128xi16>
        // Invalid reciprocal edge receives the special exponent threshold.
        %reversedShareExp3 = pto.mi.vsel %specialExp, %reversedShareExp2, %invalidRecipMask
          : !pto.mi.vreg<128xi16>, !pto.mi.vreg<128xi16>, !pto.mi.mask<b16> -> !pto.mi.vreg<128xi16>
        // Reinterpret signed exponent-field lanes as unsigned halfwords for UB storage.
        %reversedShareExpU16 = pto.mi.vbitcast %reversedShareExp3 : !pto.mi.vreg<128xi16> -> !pto.mi.vreg<128xui16>
        // MI: vsts + NORM_B16 按 halfword 写入, 绑定 mask<b16> (reduce 模式, 16个half/行)。
        // 对比 VMI: vmi.store。

        // Store compact reciprocal halfwords; only the reduce-width b16 lanes are written.
        pto.mi.vsts %reversedShareExpU16, %mxScaleReciprocalAddr[%c0], %pregReduceB16 {dist = "NORM_B16"}
          : !pto.mi.vreg<128xui16>, !pto.ptr<ui16, ub>, !pto.mi.mask<b16>
      }

      return
    }
  }
}
