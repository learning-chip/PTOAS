module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @mx_bmx_vmi_f16_e4m3(
      %x_gm16: !pto.ptr<ui16, gm>,
      %scale_gm16: !pto.ptr<ui16, gm>,
      %y_gm8: !pto.ptr<ui8, gm>,
      %rowNum: i32,
      %colBlockSize: i32) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2_i64 = arith.constant 2 : i64
    %c31_i64 = arith.constant 31 : i64
    %c32_i64 = arith.constant 32 : i64
    %c512_i64 = arith.constant 512 : i64
    %c1_i64 = arith.constant 1 : i64
    %c0_i64 = arith.constant 0 : i64

    %x_gm = pto.castptr %x_gm16 : !pto.ptr<ui16, gm> -> !pto.ptr<f16, gm>
    %scale_gm = pto.castptr %scale_gm16 : !pto.ptr<ui16, gm> -> !pto.ptr<bf16, gm>
    %y_gm = pto.castptr %y_gm8 : !pto.ptr<ui8, gm> -> !pto.ptr<f8E4M3FN, gm>

    %row_count = arith.index_cast %rowNum : i32 to index
    %col_count = arith.index_cast %colBlockSize : i32 to index

    %x_elems = arith.muli %row_count, %col_count : index
    %x_elems_i64 = arith.index_cast %x_elems : index to i64
    %x_bytes = arith.muli %x_elems_i64, %c2_i64 : i64
    %x_lines = arith.addi %x_bytes, %c31_i64 : i64
    %x_lines_q = arith.divui %x_lines, %c32_i64 : i64
    %x_dma_bytes = arith.muli %x_lines_q, %c32_i64 : i64

    %y_elems_i64 = arith.index_cast %x_elems : index to i64
    %y_lines = arith.addi %y_elems_i64, %c31_i64 : i64
    %y_lines_q = arith.divui %y_lines, %c32_i64 : i64
    %y_dma_bytes = arith.muli %y_lines_q, %c32_i64 : i64

    %scale_ub_off = arith.addi %x_dma_bytes, %c0_i64 : i64
    %y_ub_off = arith.addi %scale_ub_off, %c512_i64 : i64

    %x_ub = pto.castptr %c0_i64 : i64 -> !pto.ptr<f16, ub>
    %scale_ub = pto.castptr %scale_ub_off : i64 -> !pto.ptr<bf16, ub>
    %y_ub = pto.castptr %y_ub_off : i64 -> !pto.ptr<f8E4M3FN, ub>

    pto.mte_gm_ub %x_gm, %x_ub, %c0_i64, %x_dma_bytes
      nburst(%c1_i64, %x_dma_bytes, %x_dma_bytes)
      : !pto.ptr<f16, gm>, !pto.ptr<f16, ub>, i64, i64, i64, i64, i64
    pto.mte_gm_ub %scale_gm, %scale_ub, %c0_i64, %c512_i64
      nburst(%c1_i64, %c512_i64, %c512_i64)
      : !pto.ptr<bf16, gm>, !pto.ptr<bf16, ub>, i64, i64, i64, i64, i64

    pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]

      // ========================================================================
      // VMI - Block MX Quant f16->fp8_e4m3 量化执行路径 (语义级抽象)
      //
      // 算法流程 (与 MI 版本完全一致):
      //   1. 加载 reciprocal scale (bf16) -> 提升到 f32
      //   2. 逐行: vload f16 -> vcvt 提升 f32 -> vmul 乘 scale -> vcvt 截断 fp8 -> vstore
      //
      // VMI 相比 MI 的核心简化 (参考 vmi-design-comparison.md 第3节):
      //
      //   MI 写法 (loop body 17 条指令)          VMI 写法 (loop body 5 条指令)
      //   ---------------------------------       ------------------------------
      //   vldsx2 + DINTLV_B16 交错拆成 low/high   pto.vmi.vload (逻辑连续向量 vreg<256>)
      //   4x vcvt EVEN/ODD -> 4路 f32 交织         1x pto.vmi.vcvt (语义精度提升)
      //   4x vmul + mask<b32>                     1x pto.vmi.vmul (无 mask 参数)
      //   4x vcvt P0~P3 + rnd/sat                 1x pto.vmi.vcvt (自动舍入/饱和)
      //   3x vor + vbitcast + 4x vsts PK4_B32      1x pto.vmi.vstore (自动打包)
      //
      //   数据排布: 交错分散在多个寄存器            逻辑连续向量，编译器处理物理排布
      //   mask粒度: b16/b32/b8 三种分别维护         1 个 vmi.mask<256>
      //   part选择: EVEN/ODD/P0~P3 手写            无需关心
      //   store: PK4_B32 + vbitcast 显式打包        编译器自动处理
      // ========================================================================

    pto.vecscope {
      // Expected UB effect of this vecscope:
      // - Inputs already in UB: x_ub contains f16 data rows; scale_ub contains bf16
      //   reciprocal scale values from the OCP scale stage.
      // - Output modified in UB: y_ub is overwritten with packed FP8 E4M3 values.
      // - Mathematical purpose per logical element i:
      //     y[i] = fp8_e4m3( f32(x[i]) * f32(reciprocal_scale[i]) )
      //   using target lowering's round/saturate behavior for f32 -> fp8.
      // - VMI keeps the row as one logical 256-lane vector. Lowering still performs
      //   the MI split/convert/pack work needed to write dense fp8 bytes.
      // x_ub and scale_ub are read-only from the vector compute perspective.
        // VMI: plt 用逻辑长度创建统一 mask。
        // MI 对应: pset_b16 + pset_b32 + pset_b8 三种粒度分别维护。

      // VMI: plt builds a logical predicate for the 256-element row.
      // Lowering chooses the concrete b16/b32/b8 mask families needed by the
      // MI load/convert/multiply/store sequence. Algorithm code carries one mask.
      %full_mask, %mask_next = pto.vmi.plt %col_count : index -> !pto.vmi.mask<256xpred>, index

      // VMI: pto.vmi.vload reads the reciprocal scale as a logical 256xbf16 vector.
      // MI/CCE counterpart: vlds {dist="E2B_B16"} broadcasts block reciprocal
      // scale values into a physical b16 layout, then vbitcast ui16->bf16 and
      // vcvt {part="EVEN"} expose the values as f32. The VMI load names the
      // logical data contract; the compiler owns the E2B_B16 placement.

      %scale_bf16 = pto.vmi.vload %scale_ub[%c0]
        : !pto.ptr<bf16, ub> -> !pto.vmi.vreg<256xbf16>
      // vcvt mirrors the typed element conversion on an abstract vector register:
      // for every logical lane i, produce f32(scale_bf16[i]). It is not a
      // promise of one hardware vcvt; lowering may emit E2B/part-specific MI.
      %scale_fp32 = pto.vmi.vcvt %scale_bf16
        : !pto.vmi.vreg<256xbf16> -> !pto.vmi.vreg<256xf32>

      scf.for %row = %c0 to %row_count step %c1 {
        // Row base in UB element units. The vector body below intentionally ignores
        // GM copy details and describes only the __VEC_SCOPE__ compute path.
        %row_off = arith.muli %row, %col_count : index
        // ========================================================================
        // 逐行量化执行路径 - VMI 版本 (5 个语义动作)
        // 每次处理一行 256 个 f16 元素: vload -> vcvt -> vmul -> vcvt -> vstore
        //
        // (1) VMI: pto.vmi.vload 加载逻辑连续向量 256xf16。
        //     MI 对应: vldsx2 %xHalf[%blockBase], DINTLV_B16
        //       -> low(128xf16)=偶数索引, high(128xf16)=奇数索引
        //       数据从加载开始就以交错方式分散，开发者需追踪索引映射。
        //     VMI 编译器自行决定物理排布，开发者只看到 256 个连续元素。
        // ========================================================================

        %x_f16 = pto.vmi.vload %x_ub[%row_off]
          : !pto.ptr<f16, ub> -> !pto.vmi.vreg<256xf16>
        // (2) VMI: vcvt 将 256 个 f16 语义提升为 256 个 f32 - 无需 part 选择。
        //     MI 对应: 4 条 vcvt, low->EVEN/ODD, high->EVEN/ODD
        //       -> 4 个 vreg<64xf32>, 原始索引步长变成 4
        //       DINTLV_B16 拆出的 low/high 各需再拆 EVEN/ODD (f16->f32 位宽减半),
        //       开发者必须理解嵌套的交错映射关系。
        //     VMI 编译器追踪数据来源，自动选择正确的 part。
        //     Semantically this is a typed lane conversion lifted from scalar/vector IR to
        //     abstract vector registers: logical lane i stays lane i.

        %x_fp32 = pto.vmi.vcvt %x_f16
          : !pto.vmi.vreg<256xf16> -> !pto.vmi.vreg<256xf32>
        // (3) VMI: vmul 一条指令完成 256 个 f32 乘 scale - 无 mask 参数。
        //     MI 对应: 4 条 vmul, 每条绑定 mask<b32>
        //       %x0Zero1 = vmul %x0Zero0, %scaleForMulFP32, %pregAllB32
        //       %x0One1  = vmul %x0One0,  %scaleForMulFP32, %pregAllB32
        //       %x1Zero1 = vmul %x1Zero0, %scaleForMulFP32, %pregAllB32
        //       %x1One1  = vmul %x1One0,  %scaleForMulFP32, %pregAllB32
        //     4 条指令 + 4 个重复的 mask<b32> 参数。
        //     This is the only arithmetic operation in the quant stage:
        //       scaled[i] = f32(x[i]) * f32(reciprocal_scale[i]).

        %res_fp32 = pto.vmi.vmul %x_fp32, %scale_fp32
          : !pto.vmi.vreg<256xf32>, !pto.vmi.vreg<256xf32>
         -> !pto.vmi.vreg<256xf32>
        // (4) VMI: vcvt 将 256 个 f32 语义截断为 256 个 fp8_e4m3 - 无需手写参数。
        //     MI 对应: 4 条 vcvt, 每条都需显式指定 {rnd=R, sat=SAT, part=P0}
        //       %x0ZeroFP8 = vcvt %x0Zero, %pregAllB32 {rnd=R, sat=SAT, part=P0}
        //       ...共 4 条, 每条都需 rnd(舍入模式)/sat(饱和溢出)/part(P0~P3)。
        //     MI 还需要 bitcast 类型重解释和 PK4_B32 store 打包。
        //     VMI 编译器根据目标类型自动填入正确的舍入/饱和参数, 并自动处理 part 打包。
        //     This is a semantic type narrowing; the
        //     final hardware sequence is determined by the target fp8 storage layout.

        %res_fp8 = pto.vmi.vcvt %res_fp32
          : !pto.vmi.vreg<256xf32> -> !pto.vmi.vreg<256xf8E4M3FN>
        // (5) VMI: vstore 统一掩码写回, 编译器自动处理打包策略。
        //     MI 对应: 4 条 vsts, 每条绑定 mask<b32> + {dist=PK4_B32}
        //       且 store 前还需 vbitcast fp8->ui8。
        //     VMI 编译器自动选择 PK 策略, 无需开发者关心打包和 bitcast。

        pto.vmi.vstore %res_fp8, %y_ub[%row_off], %full_mask
          : !pto.vmi.vreg<256xf8E4M3FN>, !pto.ptr<f8E4M3FN, ub>, !pto.vmi.mask<256xpred>
      }
    }

    pto.set_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.wait_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]

    pto.mte_ub_gm %y_ub, %y_gm, %y_dma_bytes
      nburst(%c1_i64, %y_dma_bytes, %y_dma_bytes)
      : !pto.ptr<f8E4M3FN, ub>, !pto.ptr<f8E4M3FN, gm>, i64, i64, i64, i64
    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }
}
